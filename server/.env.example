# Groq API — get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for answer generation
# Options: llama-3.1-8b-instant | llama-3.3-70b-versatile | gemma2-9b-it | mixtral-8x7b-32768
GROQ_MODEL='openai/gpt-oss-120b'

# Express server port
PORT=5000

# Set to "production" on the server
NODE_ENV=production
